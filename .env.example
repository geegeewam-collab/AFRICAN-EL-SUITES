# Public site URL (used for SEO/share previews)
NEXT_PUBLIC_SITE_URL=https://serenitysuites.co.ke

# Firebase: Console > Project settings > Service accounts > Generate new private key.
# Paste the WHOLE json file as ONE line. Firestore rules: deny all client access
# (the server uses the admin SDK, which bypasses rules).
FIREBASE_SERVICE_ACCOUNT=

# Safaricom Daraja. Use sandbox until the OWNER's shortcode is approved for live.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Till (Buy Goods)? set CustomerBuyGoodsOnline and DARAJA_PARTY_B=<till number>
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_PARTY_B=
# Long random string; also goes in the callback URL below
DARAJA_CALLBACK_SECRET=
DARAJA_CALLBACK_URL=https://serenitysuites.co.ke/api/mpesa/callback?token=SAME_AS_SECRET

# Owner dashboard at /admin. Use a LONG password (a few random words) and a random secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Booking alert emails (free). Use a Gmail App Password: Google Account > Security >
# 2-Step Verification > App passwords. ALERT_EMAIL_TO defaults to ALERT_EMAIL_USER.
ALERT_EMAIL_USER=
ALERT_EMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=