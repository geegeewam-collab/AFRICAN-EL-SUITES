# =====================================================================
#  Copy these into Vercel: Project > Settings > Environment Variables
#  Then REDEPLOY (Deployments > latest > ... > Redeploy). See SETUP.md.
#  Variables starting NEXT_PUBLIC_ are baked in at build time, so
#  changing them ALWAYS needs a redeploy.
# =====================================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://your-domain.co.ke

# ---- Owner dashboard (/admin) ----
# Password: 12+ characters (3-4 random words is perfect). Change it later inside the dashboard.
ADMIN_PASSWORD=
# Any long random text (40+ characters). Change it to instantly log everybody out.
ADMIN_SESSION_SECRET=

# ---- Database (Firebase > Project settings > Service accounts > Generate new private key) ----
# Paste the WHOLE downloaded JSON file as ONE line.
FIREBASE_SERVICE_ACCOUNT=

# ---- M-Pesa (Safaricom Daraja, the OWNER's own paybill/till) ----
DARAJA_ENV=sandbox                 # change to: production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline   # till numbers: CustomerBuyGoodsOnline
DARAJA_PARTY_B=                    # till numbers only: the till number
DARAJA_CALLBACK_SECRET=            # make up a long random text
DARAJA_CALLBACK_URL=https://your-domain.co.ke/api/mpesa/callback?token=SAME_TEXT_AS_DARAJA_CALLBACK_SECRET
# Flip to true ONLY when M-Pesa is live. false = guests send a WhatsApp booking request instead.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ---- Automatic SMS (Africa's Talking: africastalking.com) ----
AT_USERNAME=sandbox                # sandbox = nothing is delivered. Change to your real app username to go live.
AT_API_KEY=
AT_SENDER_ID=                      # optional, only if Africa's Talking approved one for you
OWNER_ALERT_PHONE=2547XXXXXXXX     # the owner's number for "new booking" SMS (defaults to the WhatsApp number)
NEXT_PUBLIC_SMS_ENABLED=false      # true once SMS is live (adds "a confirmation SMS is on its way" to the guest screen)

# ---- Email alert to the owner (free, via Gmail) ----
ALERT_EMAIL_USER=                  # the Gmail address
ALERT_EMAIL_APP_PASSWORD=          # a Gmail "App password" (NOT the normal password)
ALERT_EMAIL_TO=                    # optional, defaults to ALERT_EMAIL_USER

# ---- Airbnb / Booking.com calendar sync (optional) ----
ICAL_EXPORT_TOKEN=                 # long random text; makes the link you give Airbnb private
ICAL_IMPORT_URLS=                  # their "export calendar" links, separated by commas (https only)
